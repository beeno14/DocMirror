# Shared test-server layout. Copy to a root-owned environment file and source it
# before running the management scripts. Do not place credentials in this file.

DOCMIRROR_APP_HOME=/home/docmirror

# vNext release managed by the existing /home/docmirror/current symlink.
DOCMIRROR_VNEXT_ROOT=/home/docmirror/current
DOCMIRROR_VNEXT_PYTHON=/home/docmirror/current/venv/bin/python
DOCMIRROR_VNEXT_PORT=8000
DOCMIRROR_VNEXT_PID_FILE=/home/docmirror/api.pid
DOCMIRROR_VNEXT_LOG_FILE=/home/docmirror/api.log
DOCMIRROR_VNEXT_ENV_FILE=/home/docmirror/.env

# Legacy source and runtime are isolated under /home/docmirror/docmirror_old.
DOCMIRROR_LEGACY_ROOT=/home/docmirror/docmirror_old
DOCMIRROR_LEGACY_PYTHON=/home/docmirror/docmirror_old/venv/bin/python
DOCMIRROR_LEGACY_PORT=8002
DOCMIRROR_LEGACY_PID_FILE=/home/docmirror/docmirror_old/api.pid
DOCMIRROR_LEGACY_LOG_FILE=/home/docmirror/docmirror_old/api.log
DOCMIRROR_LEGACY_ENV_FILE=/home/docmirror/docmirror_old/.env.test

DOCMIRROR_UVICORN_WORKERS=1
DOCMIRROR_STARTUP_TIMEOUT_SECONDS=120
DOCMIRROR_STOP_TIMEOUT_SECONDS=30
