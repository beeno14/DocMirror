{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuemapglobal.github.io/DocMirror/schemas/personal_credit_report_detailed.schema.json",
  "title": "DocMirror Personal Detailed Credit Report v1.2",
  "description": "Domain contract for individual detailed credit reports. datasets[*].rows is the sole canonical business-record storage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "document", "sections", "datasets", "reading", "files", "warnings"],
  "properties": {
    "schema": {
      "type": "object",
      "required": ["name", "version", "edition", "domain", "support_level"],
      "properties": {
        "name": {"const": "docmirror.community"},
        "version": {"const": "3.0.0"},
        "edition": {"const": "community"},
        "domain": {"const": "personal_credit_report_detailed"},
        "support_level": {"enum": ["ga", "beta"]}
      },
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "required": ["id", "type", "title", "page_count", "language", "source_file", "units"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"const": "personal_credit_report_detailed"},
        "title": {"type": "string", "minLength": 1},
        "page_count": {"type": "integer", "minimum": 1},
        "language": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "source_file": {
          "type": "object",
          "required": ["name", "mime_type", "sha256"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "mime_type": {"const": "application/pdf"},
            "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "units": {"type": "object"},
        "domain_schema": {
          "type": "object",
          "required": ["id", "version", "contract_uri", "compatibility"],
          "properties": {
            "id": {"const": "personal_credit_report_detailed"},
            "version": {"const": "1.2.0"},
            "contract_uri": {"type": "string", "format": "uri"},
            "compatibility": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "sections": {"type": "array", "items": {"type": "object"}},
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/canonicalDataset"},
      "contains": {
        "type": "object",
        "properties": {"name": {"const": "personal_report_metadata"}},
        "required": ["name"]
      }
    },
    "reading": {"type": "object"},
    "files": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "pageRange": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "source": {
      "type": "object",
      "properties": {
        "source_refs": {"type": "array", "items": {"type": "object"}},
        "source_cell_refs": {"type": "array", "items": {"type": "object"}},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": ["number", "string"]},
        "page_range": {"$ref": "#/$defs/pageRange"}
      },
      "additionalProperties": true
    },
    "record": {
      "type": "object",
      "required": ["record_id", "normalized", "canonical_raw", "raw", "source"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "normalized": {"type": "object"},
        "canonical_raw": {"type": "object"},
        "raw": {"type": "object"},
        "source": {"$ref": "#/$defs/source"},
        "confidence": {"type": ["number", "string"]},
        "review": {"type": "object"}
      },
      "additionalProperties": false
    },
    "nullableString": {"type": ["string", "null"]},
    "decimalString": {
      "type": ["string", "null"],
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "canonicalDataset": {
      "type": "object",
      "required": [
        "id", "name", "label", "type", "section_id", "csv", "row_count",
        "grain", "primary_key", "schema_version", "storage_role", "record_path",
        "status", "columns", "completeness", "rows"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "label": {"type": "string"},
        "type": {"type": "string", "minLength": 1},
        "section_id": {"type": "string"},
        "csv": {"type": "string", "pattern": "_datasets/[0-9a-z_]+\\.csv$"},
        "row_count": {"type": "integer", "minimum": 0},
        "grain": {"type": "string", "minLength": 1},
        "primary_key": {"const": "record_id"},
        "schema_version": {"const": "1.0"},
        "storage_role": {"const": "canonical"},
        "record_path": {"const": "rows"},
        "status": {"enum": ["complete", "empty", "partial", "failed"]},
        "columns": {"type": "array", "items": {"type": "object"}},
        "completeness": {
          "type": "object",
          "required": ["expected_row_count", "emitted_row_count", "omitted_row_count", "verified", "basis"],
          "properties": {
            "expected_row_count": {"type": "integer", "minimum": 0},
            "emitted_row_count": {"type": "integer", "minimum": 0},
            "omitted_row_count": {"type": "integer", "minimum": 0},
            "verified": {"type": "boolean"},
            "basis": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "reading_columns": {"type": "array", "items": {"type": "string"}},
        "representation_role": {
          "enum": ["source_canonical", "business_canonical", "control"]
        },
        "derived_from": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "foreign_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["columns", "reference_dataset", "reference_columns"],
            "properties": {
              "columns": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "reference_dataset": {"type": "string", "minLength": 1},
              "reference_columns": {"type": "array", "items": {"type": "string"}, "minItems": 1}
            },
            "additionalProperties": false
          }
        },
        "rows": {"type": "array", "items": {"$ref": "#/$defs/record"}}
      },
      "allOf": [
        {
          "if": {"properties": {"name": {"const": "credit_accounts"}}, "required": ["name"]},
          "then": {
            "properties": {
              "rows": {
                "items": {
                  "properties": {
                    "normalized": {
                      "required": ["account_id", "sequence", "account_type"],
                      "properties": {
                        "account_id": {"type": "string", "minLength": 1},
                        "sequence": {"type": "integer", "minimum": 1},
                        "account_type": {
                          "enum": [
                            "non_revolving_loan", "revolving_loan", "revolving_loan_subaccount",
                            "revolving_loan_account", "credit_card", "quasi_credit_card"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"name": {"const": "repayment_records"}}, "required": ["name"]},
          "then": {
            "properties": {
              "rows": {
                "items": {
                  "properties": {
                    "normalized": {
                      "required": ["repayment_id", "account_id", "year", "month", "status"],
                      "properties": {
                        "year": {"type": "integer", "minimum": 1900, "maximum": 2200},
                        "month": {"type": "integer", "minimum": 1, "maximum": 12},
                        "status": {"enum": ["*", "N", "1", "2", "3", "4", "5", "6", "7", "A", "B", "C", "D", "G", "M", "Z", "#", "unknown"]}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"name": {"const": "credit_lines"}}, "required": ["name"]},
          "then": {
            "properties": {
              "rows": {
                "items": {
                  "properties": {
                    "normalized": {"required": ["credit_line_id", "account_identifier", "institution"]}
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"name": {"const": "postpaid_payment_history"}}, "required": ["name"]},
          "then": {
            "properties": {
              "rows": {
                "items": {
                  "properties": {
                    "normalized": {
                      "required": ["postpaid_payment_history_id", "postpaid_record_id", "year", "month", "status"],
                      "properties": {
                        "year": {"type": "integer", "minimum": 1900, "maximum": 2200},
                        "month": {"type": "integer", "minimum": 1, "maximum": 12},
                        "status": {"enum": ["*", "N", "0", "1", "2", "3", "4", "5", "6", "C", "G", "#", "unknown"]}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"name": {"const": "inquiry_records"}}, "required": ["name"]},
          "then": {
            "properties": {
              "rows": {
                "items": {
                  "properties": {
                    "normalized": {
                      "required": ["inquiry_id", "sequence", "inquiry_type", "inquiry_date", "institution", "reason"],
                      "properties": {"inquiry_type": {"enum": ["institution", "personal"]}}
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"name": {"const": "personal_detail_source_rows"}}, "required": ["name"]},
          "then": {
            "properties": {
              "rows": {
                "items": {
                  "properties": {
                    "normalized": {"required": ["source_table_row_id", "page", "table_id", "row_index", "cells"]}
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"name": {"const": "personal_profile"}}, "required": ["name"]},
          "then": {
            "properties": {
              "rows": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "normalized": {
                      "required": ["personal_profile_id"],
                      "properties": {
                        "personal_profile_id": {"type": "string", "minLength": 1},
                        "birth_date": {"type": ["string", "null"], "pattern": "^[0-9]{4}[-.][0-9]{2}[-.][0-9]{2}$"}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"name": {"const": "personal_detail_field_observations"}}, "required": ["name"]},
          "then": {
            "properties": {
              "rows": {
                "items": {
                  "properties": {
                    "normalized": {
                      "required": [
                        "field_observation_id", "dataset_name", "business_record_id",
                        "field_name", "observation_status"
                      ],
                      "properties": {
                        "dataset_name": {"type": "string", "minLength": 1},
                        "observation_status": {
                          "enum": [
                            "observed", "normalized", "ocr_corrected", "inferred", "ambiguous",
                            "unreadable", "not_observed", "explicitly_absent", "not_applicable"
                          ]
                        },
                        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
                        "confidence_status": {"enum": ["available", "not_available"]},
                        "confidence_basis": {"type": "string", "minLength": 1}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"name": {"const": "personal_detail_credit_summary_metrics"}}, "required": ["name"]},
          "then": {
            "properties": {
              "rows": {
                "items": {
                  "properties": {
                    "normalized": {
                      "required": [
                        "credit_summary_metric_id", "summary_record_id", "row_index", "column_index",
                        "metric_name", "source_value", "value_type", "reporting_status"
                      ],
                      "properties": {
                        "value_type": {"enum": ["integer", "decimal", "money", "percentage", "date", "text", "placeholder"]},
                        "reporting_status": {"enum": ["reported", "not_reported"]},
                        "mapping_status": {"enum": ["mapped", "unmapped"]},
                        "numeric_value": {"$ref": "#/$defs/decimalString"},
                        "text_value": {"$ref": "#/$defs/nullableString"},
                        "date_value": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}(?:-[0-9]{2})?$"},
                        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
                        "amount_unit": {"enum": ["yuan", null]}
                      },
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "value_type": {"const": "placeholder"},
                              "mapping_status": {"enum": ["mapped", "unmapped"]}
                            },
                            "required": ["value_type", "mapping_status"]
                          },
                          "then": {"properties": {"reporting_status": {"const": "not_reported"}, "text_value": {"type": "null"}}}
                        },
                        {
                          "if": {"properties": {"value_type": {"const": "money"}}, "required": ["value_type"]},
                          "then": {"properties": {"currency": {"const": "CNY"}, "amount_unit": {"const": "yuan"}}}
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"name": {"const": "personal_detail_dataset_status"}}, "required": ["name"]},
          "then": {
            "properties": {
              "rows": {
                "items": {
                  "properties": {
                    "normalized": {
                      "required": ["dataset_status_id", "dataset_name", "applicability", "presence_status", "observed_row_count", "reason"],
                      "properties": {
                        "applicability": {"enum": ["applicable", "not_applicable", "unknown"]},
                        "presence_status": {
                          "enum": ["observed_nonempty", "explicitly_empty", "not_applicable", "not_observed", "partial", "extraction_failed", "unknown"]
                        },
                        "observed_row_count": {"type": "integer", "minimum": 0}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "enum": [
                  "tax_arrears_records", "civil_judgment_records", "enforcement_records",
                  "administrative_penalty_records", "personal_housing_fund_records"
                ]
              }
            },
            "required": ["name"]
          },
          "then": {
            "properties": {
              "rows": {
                "items": {
                  "properties": {
                    "normalized": {
                      "properties": {
                        "arrears_amount": {"$ref": "#/$defs/decimalString"},
                        "claim_amount": {"$ref": "#/$defs/decimalString"},
                        "requested_amount": {"$ref": "#/$defs/decimalString"},
                        "executed_amount": {"$ref": "#/$defs/decimalString"},
                        "penalty_amount": {"$ref": "#/$defs/decimalString"},
                        "monthly_contribution": {"$ref": "#/$defs/decimalString"},
                        "reporting_amount_currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
                        "reporting_amount_unit": {"enum": ["yuan", null]}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
