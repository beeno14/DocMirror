{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuemapglobal.github.io/DocMirror/schemas/personal_credit_report_detailed.schema.json",
  "title": "DocMirror PBOC Personal Detailed Credit Report v2.0",
  "description": "PBOC-native domain contract. datasets[*].rows[*].normalized is the sole canonical business-record storage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "document", "sections", "datasets", "reading", "files", "warnings"],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "edition", "domain", "support_level"],
      "properties": {
        "name": {"const": "docmirror.community"},
        "version": {"const": "3.0.0"},
        "edition": {"const": "community"},
        "domain": {"const": "personal_credit_report_detailed"},
        "support_level": {"enum": ["ga", "beta"]}
      }
    },
    "document": {
      "type": "object",
      "required": ["id", "type", "title", "page_count", "language", "source_file", "units", "domain_schema"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"const": "personal_credit_report_detailed"},
        "title": {"type": "string", "minLength": 1},
        "page_count": {"type": "integer", "minimum": 1},
        "language": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "source_file": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "mime_type", "sha256"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "mime_type": {"const": "application/pdf"},
            "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          }
        },
        "units": {"type": "object"},
        "domain_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "contract_uri", "compatibility", "dataset_status_semantics"],
          "properties": {
            "id": {"const": "personal_credit_report_detailed"},
            "version": {"const": "2.0.0"},
            "contract_uri": {
              "const": "https://valuemapglobal.github.io/DocMirror/schemas/personal_credit_report_detailed.schema.json"
            },
            "compatibility": {"type": "string", "minLength": 1},
            "dataset_status_semantics": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode", "present_dataset_without_status",
                "absent_dataset_without_status", "status_row_present"
              ],
              "properties": {
                "mode": {"const": "potentially_flawed_only"},
                "present_dataset_without_status": {"const": "silently_trusted_complete"},
                "absent_dataset_without_status": {"const": "silently_trusted_empty_or_not_applicable"},
                "status_row_present": {"const": "partial_unknown_or_failed_extraction"}
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "sections": {"type": "array", "items": {"type": "object"}},
    "datasets": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/canonicalDataset"},
      "allOf": [
        {"contains": {"properties": {"name": {"const": "report_metadata"}}, "required": ["name"]}},
        {"contains": {"properties": {"name": {"const": "report_query"}}, "required": ["name"]}},
        {"contains": {"properties": {"name": {"const": "subject_profile"}}, "required": ["name"]}}
      ]
    },
    "reading": {"type": "object"},
    "files": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "month": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])$"
    },
    "decimalString": {
      "type": ["string", "null"],
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "pageRange": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "source": {
      "type": "object",
      "properties": {
        "source_refs": {"type": "array", "items": {"type": "object"}},
        "source_cell_refs": {"type": "array", "items": {"type": "object"}},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": ["number", "string"]},
        "page_range": {"$ref": "#/$defs/pageRange"}
      },
      "additionalProperties": true
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "normalized", "canonical_raw", "raw", "source"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "normalized": {"type": "object"},
        "canonical_raw": {"type": "object"},
        "raw": {"type": "object"},
        "source": {"$ref": "#/$defs/source"},
        "confidence": {"type": ["number", "string"]},
        "review": {"type": "object"}
      }
    },
    "datasetName": {
      "enum": [
        "report_metadata", "report_query", "subject_profile", "subject_identity_documents",
        "fraud_warnings", "dispute_overview", "subject_mobile_phones", "subject_spouse",
        "subject_residences", "subject_employment", "credit_scores", "credit_score_reasons",
        "credit_business_overview", "bad_debt_summary", "recovery_summary", "delinquency_summary",
        "account_portfolio_summary", "repayment_responsibility_summary", "postpaid_arrears_summary",
        "public_negative_summary", "inquiry_summary", "credit_accounts", "credit_account_snapshots",
        "credit_account_history_windows", "credit_account_monthly_performance",
        "credit_account_latest_repayments", "credit_account_special_transactions",
        "credit_account_special_events", "credit_card_large_installments", "recovery_account_details",
        "credit_agreements", "account_credit_agreement_links", "repayment_responsibilities",
        "postpaid_accounts", "postpaid_history_windows", "postpaid_monthly_performance",
        "tax_arrears_records", "civil_judgment_records", "enforcement_records",
        "administrative_penalty_records", "housing_fund_records", "social_assistance_records",
        "professional_qualification_records", "administrative_award_records",
        "annotation_statement_groups", "annotation_statements", "inquiries",
        "field_observations", "extraction_issues", "extraction_issue_evidence",
        "pboc_extension_fields", "dataset_status"
      ]
    },
    "canonicalDataset": {
      "type": "object",
      "required": [
        "id", "name", "label", "type", "section_id", "csv", "row_count",
        "grain", "primary_key", "schema_version", "storage_role", "record_path",
        "status", "columns", "completeness", "rows"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"$ref": "#/$defs/datasetName"},
        "label": {"type": "string"},
        "type": {"type": "string", "minLength": 1},
        "section_id": {"type": "string"},
        "csv": {"type": "string", "pattern": "_datasets/[0-9a-z_]+\\.csv$"},
        "row_count": {"type": "integer", "minimum": 0},
        "grain": {"type": "string", "minLength": 1},
        "primary_key": {"const": "record_id"},
        "schema_version": {"const": "1.0"},
        "storage_role": {"const": "canonical"},
        "record_path": {"const": "rows"},
        "status": {"enum": ["complete", "empty", "partial", "failed"]},
        "columns": {"type": "array", "items": {"type": "object"}},
        "completeness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expected_row_count", "emitted_row_count", "omitted_row_count", "verified", "basis"],
          "properties": {
            "expected_row_count": {"type": "integer", "minimum": 0},
            "emitted_row_count": {"type": "integer", "minimum": 0},
            "omitted_row_count": {"type": "integer", "minimum": 0},
            "verified": {"type": "boolean"},
            "basis": {"type": "string", "minLength": 1}
          }
        },
        "reading_columns": {"type": "array", "items": {"type": "string"}},
        "sparse_status_semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode", "present_dataset_without_status",
            "absent_dataset_without_status", "status_row_present"
          ],
          "properties": {
            "mode": {"const": "potentially_flawed_only"},
            "present_dataset_without_status": {"const": "silently_trusted_complete"},
            "absent_dataset_without_status": {"const": "silently_trusted_empty_or_not_applicable"},
            "status_row_present": {"const": "partial_unknown_or_failed_extraction"}
          }
        },
        "representation_role": {"enum": ["source_canonical", "business_canonical", "control"]},
        "derived_from": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "foreign_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["columns", "reference_dataset", "reference_columns"],
            "properties": {
              "columns": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "reference_dataset": {"type": "string", "minLength": 1},
              "reference_columns": {"type": "array", "items": {"type": "string"}, "minItems": 1}
            }
          }
        },
        "rows": {"type": "array", "items": {"$ref": "#/$defs/record"}}
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {"properties": {"name": {"const": "report_metadata"}}, "required": ["name"]},
          "then": {"properties": {"rows": {"items": {"properties": {"normalized": {
            "required": ["report_metadata_id", "report_number", "report_time"]
          }}}}}}
        },
        {
          "if": {"properties": {"name": {"const": "report_query"}}, "required": ["name"]},
          "then": {"properties": {"rows": {"items": {"properties": {"normalized": {
            "required": ["report_query_id", "report_number", "query_institution", "query_reason"]
          }}}}}}
        },
        {
          "if": {"properties": {"name": {"const": "subject_profile"}}, "required": ["name"]},
          "then": {"properties": {"rows": {"items": {"properties": {"normalized": {
            "required": ["subject_profile_id"],
            "properties": {"birth_date": {"$ref": "#/$defs/date"}}
          }}}}}}
        },
        {
          "if": {"properties": {"name": {"const": "credit_accounts"}}, "required": ["name"]},
          "then": {"properties": {"rows": {"items": {"properties": {"normalized": {
            "required": ["account_id", "pboc_account_type_code", "pboc_account_type_label"],
            "properties": {
              "pboc_account_type_code": {"enum": ["D1", "R1", "R2", "R3", "R4"]}
            }
          }}}}}}
        },
        {
          "if": {"properties": {"name": {"const": "credit_account_monthly_performance"}}, "required": ["name"]},
          "then": {"properties": {"rows": {"items": {"properties": {"normalized": {
            "required": ["monthly_performance_id", "account_id", "performance_month", "status_code"],
            "properties": {
              "performance_month": {"$ref": "#/$defs/month"},
              "status_code": {"enum": ["*", "/", "#", "N", "1", "2", "3", "4", "5", "6", "7", "A", "B", "C", "D", "G", "M", "Z", "unknown"]},
              "status_amount": {"$ref": "#/$defs/decimalString"},
              "status_amount_semantics": {"enum": ["delinquent_amount", "overdraft_balance", null]}
            }
          }}}}}}
        },
        {
          "if": {"properties": {"name": {"const": "repayment_responsibilities"}}, "required": ["name"]},
          "then": {"properties": {"rows": {"items": {"properties": {"normalized": {
            "required": ["repayment_responsibility_id", "related_party_category"],
            "properties": {
              "related_party_category": {"enum": ["person", "organization", "unknown"]},
              "overdue_months": {"type": ["integer", "null"], "minimum": 0},
              "repayment_status_code": {"type": ["string", "null"]}
            },
            "not": {"required": ["overdue_months_or_repayment_status"]}
          }}}}}}
        },
        {
          "if": {"properties": {"name": {"const": "postpaid_monthly_performance"}}, "required": ["name"]},
          "then": {"properties": {"rows": {"items": {"properties": {"normalized": {
            "required": ["postpaid_monthly_performance_id", "performance_month", "status_code"],
            "properties": {"performance_month": {"$ref": "#/$defs/month"}}
          }}}}}}
        },
        {
          "if": {"properties": {"name": {"const": "housing_fund_records"}}, "required": ["name"]},
          "then": {"properties": {"rows": {"items": {"properties": {"normalized": {
            "properties": {
              "first_contribution_month": {"$ref": "#/$defs/month"},
              "paid_through_month": {"$ref": "#/$defs/month"},
              "information_updated_month": {"$ref": "#/$defs/month"},
              "personal_contribution_ratio_percent": {"type": ["integer", "null"], "minimum": 0},
              "employer_contribution_ratio_percent": {"type": ["integer", "null"], "minimum": 0}
            },
            "not": {"anyOf": [
              {"required": ["personal_contribution_ratio"]},
              {"required": ["employer_contribution_ratio"]}
            ]}
          }}}}}}
        },
        {
          "if": {"properties": {"name": {"enum": ["administrative_penalty_records", "administrative_award_records"]}}, "required": ["name"]},
          "then": {"properties": {"rows": {"items": {"properties": {"normalized": {
            "properties": {"effective_month": {"$ref": "#/$defs/month"}, "end_month": {"$ref": "#/$defs/month"}}
          }}}}}}
        },
        {
          "if": {"properties": {"name": {"const": "professional_qualification_records"}}, "required": ["name"]},
          "then": {"properties": {"rows": {"items": {"properties": {"normalized": {
            "properties": {
              "obtained_month": {"$ref": "#/$defs/month"},
              "expiry_month": {"$ref": "#/$defs/month"},
              "revocation_month": {"$ref": "#/$defs/month"}
            }
          }}}}}}
        },
        {
          "if": {"properties": {"name": {"const": "annotation_statements"}}, "required": ["name"]},
          "then": {"properties": {"rows": {"items": {"properties": {"normalized": {
            "required": ["annotation_statement_id", "annotation_statement_group_id", "annotation_kind", "text"],
            "properties": {"annotation_kind": {"enum": ["statement", "annotation"]}}
          }}}}}}
        },
        {
          "if": {"properties": {"name": {"const": "field_observations"}}, "required": ["name"]},
          "then": {"properties": {"rows": {"items": {"properties": {"normalized": {
            "required": ["field_observation_id", "dataset_name", "business_record_id", "field_name", "observation_status"],
            "properties": {
              "dataset_name": {
                "anyOf": [
                  {"$ref": "#/$defs/datasetName"},
                  {"const": "unknown"}
                ]
              },
              "source_dataset_name": {"type": ["string", "null"], "minLength": 1},
              "observation_status": {"enum": ["ocr_corrected", "inferred", "ambiguous", "unreadable", "not_observed"]}
            }
          }}}}}}
        },
        {
          "if": {"properties": {"name": {"const": "extraction_issues"}}, "required": ["name"]},
          "then": {"properties": {"rows": {"items": {"properties": {"normalized": {
            "required": ["extraction_issue_id", "category", "issue_code", "severity", "status"],
            "properties": {"target_dataset": {"type": ["string", "null"], "minLength": 1}}
          }}}}}}
        },
        {
          "if": {"properties": {"name": {"const": "extraction_issue_evidence"}}, "required": ["name"]},
          "then": {"properties": {"rows": {"items": {"properties": {"normalized": {
            "required": ["extraction_issue_evidence_id", "extraction_issue_id", "evidence_kind", "evidence_path", "value_type"],
            "properties": {
              "evidence_kind": {"enum": ["observed", "candidate", "reason"]},
              "value_type": {"enum": ["string", "integer", "number", "boolean"]}
            }
          }}}}}}
        },
        {
          "if": {"properties": {"name": {"const": "pboc_extension_fields"}}, "required": ["name"]},
          "then": {"properties": {"rows": {"items": {"properties": {"normalized": {
            "required": ["pboc_extension_field_id", "namespace", "source_dataset", "source_record_id", "field_name", "value"]
          }}}}}}
        },
        {
          "if": {"properties": {"name": {"const": "dataset_status"}}, "required": ["name"]},
          "then": {"properties": {"rows": {"items": {"properties": {"normalized": {
            "required": ["dataset_status_record_id", "dataset_name", "applicability", "presence_status", "observed_row_count", "reason"],
            "properties": {
              "dataset_name": {
                "$ref": "#/$defs/datasetName",
                "not": {"enum": ["field_observations", "extraction_issues", "extraction_issue_evidence", "pboc_extension_fields", "dataset_status"]}
              },
              "source_dataset_name": {"type": ["string", "null"]},
              "presence_status": {"enum": ["not_observed", "partial", "extraction_failed", "unknown"]},
              "observed_row_count": {"type": "integer", "minimum": 0}
            }
          }}}}}}
        }
      ]
    }
  }
}
