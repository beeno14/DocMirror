{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://valuemapglobal.github.io/DocMirror/schemas/community_bundle.schema.json",
  "title": "DocMirror Community Bundle JSON v3 / normalized v4 / business v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "document", "sections", "datasets", "reading", "files"],
  "properties": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "edition", "domain", "support_level"],
      "properties": {
        "name": {"const": "docmirror.community"},
        "version": {"enum": ["3.0.0", "4.0.0", "5.0.0"]},
        "edition": {"const": "community"},
        "domain": {"type": "string", "minLength": 1},
        "support_level": {"enum": ["ga", "beta", "generic", "unsupported"]}
      }
    },
      "document": {
        "type": "object",
        "additionalProperties": true,
      "required": ["id", "type", "title", "page_count", "language", "source_file", "units"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "page_count": {"type": "integer", "minimum": 0},
        "language": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "source_file": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "mime_type", "sha256"],
          "properties": {
            "name": {"type": "string"},
            "mime_type": {"type": "string"},
            "sha256": {"type": "string"}
          }
        },
        "units": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "sections": {
      "type": "array",
      "items": {"$ref": "#/$defs/section"}
    },
    "datasets": {
      "type": "array",
      "items": {"$ref": "#/$defs/dataset"}
    },
    "reading": {"$ref": "#/$defs/reading"},
      "files": {
        "type": "object",
        "additionalProperties": true,
        "required": ["content_md", "enhanced_reading_md", "datasets_dir", "dataset_audit_csv"],
        "properties": {
          "content_md": {"type": "string", "pattern": "_content\\.md$"},
        "enhanced_reading_md": {"type": "string", "pattern": "_enhanced_reading\\.md$"},
        "datasets_dir": {"type": "string", "pattern": "_datasets$"},
        "dataset_audit_csv": {"type": "string", "pattern": "_datasets/_audit_cells\\.csv$"}
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "warnings"],
      "properties": {
        "route": {"const": "digital"},
        "warnings": {"$ref": "#/properties/warnings"}
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "level", "message"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "level": {"enum": ["info", "warning", "error"]},
          "message": {"type": "string"},
          "section_id": {"type": "string"},
          "dataset_id": {"type": "string"},
          "page_range": {"$ref": "#/$defs/pageRange"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema": {"properties": {"version": {"const": "5.0.0"}}}}},
      "then": {
        "required": ["extraction"],
        "properties": {
          "schema": {"properties": {"domain": {"const": "bank_statement"}}},
          "reading": {
            "required": ["presentation", "privacy_mode"],
            "properties": {"presentation": {"const": "bank_business"}, "privacy_mode": {"const": "full"}}
          },
          "warnings": false,
          "datasets": {"items": {"properties": {
            "primary_key": {"const": "extraction.record_id"},
            "storage_role": false,
            "record_path": false,
            "columns": {"items": {"properties": {"raw_available": false, "evidence_available": false}}},
            "rows": {"items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["normalized", "extraction"],
              "properties": {
                "normalized": {
                  "type": "object",
                  "propertyNames": {"not": {"enum": [
                    "additional_fields", "statement_header_id", "style_id", "style_confidence",
                    "parser_chain", "institution_hint", "secondary_styles", "reconstruction_source",
                    "expected_primary_rows", "extracted_rows", "coverage_ratio", "institution_authority",
                    "pipe_parse_failed", "canonical_expected", "canonical_extracted", "canonical_ratio",
                    "extract_status", "blo_tables_parsed", "blo_tables_skipped", "extraction_route",
                    "document_scene_refined", "layout_profile_id_refined", "layout_profile_refine_confidence",
                    "classification_source", "doc_type_hint_source", "user_doc_type_hint", "user_doc_type_hint_strength",
                    "mirror_expected_data_rows", "mirror_ltqg_enabled", "mirror_ltqg_export_tables",
                    "mirror_ltqg_passed_tables", "mirror_ltqg_raw_max_rows", "mirror_ltqg_skipped_tables",
                    "mirror_quarantined_logical_count", "mirror_quarantined_physical_count",
                    "counterparty_status", "source_header_page_label"
                  ]}}
                },
                "extraction": {"$ref": "#/$defs/recordExtraction"}
              }
            }}
          }}}
        }
      },
      "else": {
        "required": ["warnings"],
        "properties": {
          "extraction": false,
          "datasets": {"items": {"properties": {
            "primary_key": {"const": "record_id"},
            "columns": {"items": {"required": ["raw_available", "evidence_available"]}},
            "rows": {"items": {"required": ["record_id"]}}
          }}}
        },
        "allOf": [{
          "if": {"properties": {
            "schema": {"properties": {"version": {"const": "4.0.0"}}},
            "document": {"properties": {"type": {"const": "personal_credit_report_brief"}}}
          }},
          "then": {},
          "else": {"properties": {
            "datasets": {"items": {"properties": {
              "rows": {"items": {"required": ["source"]}}
            }}}
          }}
        }]
      }
    },
    {
      "if": {"properties": {"schema": {"properties": {"version": {"const": "3.0.0"}}}}},
      "then": {
        "properties": {
          "datasets": {"items": {"properties": {"rows": {"items": {"required": ["canonical_raw", "raw"]}}}}},
          "sections": {"items": {
            "properties": {
              "items": {"items": {"required": ["raw"]}},
              "groups": {"items": {"properties": {"items": {"items": {"required": ["raw"]}}}}}
            }
          }}
        }
      },
      "else": {
        "properties": {
          "datasets": {"items": {"properties": {"rows": {"items": {
            "properties": {
              "canonical_raw": false,
              "raw": false,
              "normalized": {"properties": {
                "additional_fields": {"type": "array", "items": {"$ref": "#/$defs/additionalField"}}
              }}
            }
          }}}}},
          "sections": {"items": {
            "properties": {
              "items": {"items": {"properties": {"raw": false}}},
              "groups": {"items": {"properties": {"items": {"items": {"properties": {"raw": false}}}}}}
            }
          }}
        }
      }
    }
  ],
  "$defs": {
    "recordExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "page_range": {"$ref": "#/$defs/pageRange"},
        "statement_header_id": {"type": "string", "minLength": 1},
        "confidence": {"type": ["number", "string"]},
        "review": {"type": "object"}
      }
    },
    "additionalField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string"},
        "field": {"type": "string", "minLength": 1},
        "value": {}
      }
    },
    "pageRange": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1},
        {"type": "integer", "minimum": 1}
      ],
      "minItems": 2,
      "maxItems": 2
    },
      "item": {
        "type": "object",
        "additionalProperties": true,
      "required": ["key", "label", "value", "type"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "value": {},
        "raw": {"type": "string"},
        "additional_values": {"type": "array"},
        "type": {"enum": ["string", "integer", "decimal", "money", "date", "datetime", "boolean", "enum", "text", "array", "object", "json"]},
        "unit": {"type": "string"}
      }
    },
      "group": {
        "type": "object",
        "additionalProperties": true,
      "required": ["key", "label", "items"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}
      }
    },
      "section": {
        "type": "object",
        "additionalProperties": true,
      "required": ["id", "title", "type", "page_range", "items", "groups", "dataset_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "type": {"type": "string", "minLength": 1},
        "page_range": {"$ref": "#/$defs/pageRange"},
        "items": {
          "type": "array",
          "description": "Scalar section facts only; dataset rows must not be embedded here.",
          "items": {"$ref": "#/$defs/item"}
        },
        "groups": {
          "type": "array",
          "description": "Grouped section facts only; dataset rows must not be embedded here.",
          "items": {"$ref": "#/$defs/group"}
        },
        "dataset_refs": {
          "type": "array",
          "description": "References to canonical records stored in the top-level datasets array.",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
      "column": {
        "type": "object",
        "additionalProperties": true,
      "required": ["key", "label", "type", "nullable"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "type": {"enum": ["string", "integer", "decimal", "money", "date", "datetime", "boolean", "enum", "text", "array", "object", "json"]},
        "unit": {"type": "string"},
        "nullable": {"type": "boolean"},
        "raw_available": {"type": "boolean"},
        "evidence_available": {"type": "boolean"},
        "source_header": {"type": "string"},
        "source_occurrence": {"type": "integer", "minimum": 1},
        "canonical_field": {"type": "string", "minLength": 1}
      }
    },
      "record": {
        "type": "object",
        "additionalProperties": true,
      "required": ["normalized"],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "normalized": {"type": "object", "additionalProperties": true},
        "canonical_raw": {"type": "object", "additionalProperties": true},
        "raw": {"type": "object", "additionalProperties": true},
        "source": {"type": "object", "additionalProperties": true},
        "confidence": {"type": ["number", "string"]},
        "review": {"type": "object", "additionalProperties": true}
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_row_count", "emitted_row_count", "omitted_row_count", "verified", "basis"
      ],
      "properties": {
        "expected_row_count": {"type": "integer", "minimum": 0},
        "emitted_row_count": {"type": "integer", "minimum": 0},
        "omitted_row_count": {"type": "integer", "minimum": 0},
        "verified": {"type": "boolean"},
        "basis": {"type": "string", "minLength": 1}
      }
    },
      "dataset": {
        "type": "object",
        "additionalProperties": true,
      "required": [
        "id", "name", "label", "type", "section_id", "csv", "row_count",
        "grain", "primary_key", "schema_version", "status", "columns", "completeness", "rows"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "type": {"type": "string", "minLength": 1},
        "section_id": {"type": "string"},
        "csv": {"type": "string", "pattern": "_datasets/[0-9a-z_]+\\.csv$"},
        "row_count": {"type": "integer", "minimum": 0},
        "grain": {"type": "string", "minLength": 1},
        "primary_key": {"enum": ["record_id", "extraction.record_id"]},
        "storage_role": {"const": "canonical"},
        "record_path": {"const": "rows"},
        "schema_version": {"const": "1.0"},
        "status": {"enum": ["complete", "empty", "partial", "failed"]},
        "columns": {"type": "array", "items": {"$ref": "#/$defs/column"}},
        "omitted_normalized_fields": {
          "type": "array",
          "description": "Optional source-absent normalized fields omitted from records and the reading view; the column catalog remains complete.",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "completeness": {"$ref": "#/$defs/completeness"},
        "rows": {
          "type": "array",
          "description": "The sole canonical storage for this dataset's complete structured records.",
          "items": {"$ref": "#/$defs/record"}
        }
      }
    },
      "readingTable": {
        "type": "object",
        "additionalProperties": true,
      "required": ["id", "dataset_id", "section_id", "title", "column_keys", "row_count"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "dataset_id": {"type": "string", "minLength": 1},
        "section_id": {"type": "string"},
        "title": {"type": "string"},
        "column_keys": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "row_count": {"type": "integer", "minimum": 0}
      }
    },
      "readingFlowEntry": {
        "type": "object",
        "additionalProperties": true,
      "required": ["order", "kind", "ref_id"],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["document", "section", "dataset"]},
        "ref_id": {"type": "string"}
      }
    },
      "reading": {
        "type": "object",
        "additionalProperties": true,
      "required": ["version", "profile", "document_flow", "tables"],
      "properties": {
        "version": {"const": "1.0"},
        "profile": {"const": "community"},
        "privacy_mode": {"enum": ["full", "masked"]},
        "document_flow": {"type": "array", "items": {"$ref": "#/$defs/readingFlowEntry"}},
        "tables": {"type": "array", "items": {"$ref": "#/$defs/readingTable"}}
      }
    }
  }
}
